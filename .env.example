# Configuração da Automação

# Destinatários no formato JSON
# type: 'contact' ou 'group'
# id: número com DDI/DDD (contato) ou ID do grupo
RECIPIENTS=[{"type":"contact","id":"5521999999999"},{"type":"group","id":"1234567890@g.us"}]

# Alternativa simples: apenas um número
# (se RECIPIENTS não for definido, TARGET_NUMBER será usado)
# TARGET_NUMBER=5521999999999

# Mensagem de texto (usada quando MESSAGE_TYPE=text)
TEST_MESSAGE=Oi! Teste de automação funcionando 🤖

# Tipo de mensagem: 'text', 'image', 'video', 'audio', 'document'
MESSAGE_TYPE=text

# Caminho do arquivo (usado para image, video, audio, document)
# O arquivo deve estar nesta pasta do projeto ou caminho absoluto
FILE_PATH=./arquivo.pdf

# Legenda opcional para imagem, vídeo e documento
FILE_CAPTION=Confira! 👀

# (DEPRECATED) Mantido para compatibilidade com versões anteriores:
# VIDEO_PATH=./meu-video.mp4
# VIDEO_CAPTION=Olha esse vídeo! 🎬

# Agendamento no formato cron
# Exemplos:
#   0 9 * * 1   = toda segunda-feira às 9h
#   0 9 * * *   = todo dia às 9h
#   0 */6 * * * = a cada 6 horas
#   */5 * * * * = a cada 5 minutos (apenas para testes)
SCHEDULE_CRON=0 9 * * 1
